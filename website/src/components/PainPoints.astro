---
// PainPoints.astro
import { type Lang, useTranslations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);
---

<section id="why" class="py-20 bg-[#090d18]/60 border-y border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-500/10 text-red-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-red-500/20">
        <i class="ri-alert-line"></i>
        <span>{t.painPoints.badge}</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t.painPoints.title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        {t.painPoints.description}
      </p>
    </div>

    <!-- Comparison Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Card 1 -->
      <div class="card-glow p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-red-400">
              <i class="ri-fire-line text-xl"></i>
            </div>
            <div>
              <span class="text-xs font-mono text-red-400 block uppercase">{t.painPoints.card1.tag}</span>
              <h3 class="text-lg font-bold text-white">{t.painPoints.card1.title}</h3>
            </div>
          </div>
          
          <div class="space-y-3 mb-6">
            <div class="p-3 rounded-lg bg-red-950/20 border border-red-900/30 text-xs text-red-300">
              <div class="font-semibold flex items-center gap-1 mb-1">
                <i class="ri-close-circle-fill text-red-400"></i>
                <span>{t.painPoints.card1.tradTitle}</span>
              </div>
              {t.painPoints.card1.tradDesc}
            </div>

            <div class="p-3 rounded-lg bg-emerald-950/20 border border-emerald-900/30 text-xs text-emerald-300">
              <div class="font-semibold flex items-center gap-1 mb-1">
                <i class="ri-checkbox-circle-fill text-emerald-400"></i>
                <span>{t.painPoints.card1.solTitle}</span>
              </div>
              {t.painPoints.card1.solDesc}
            </div>
          </div>
        </div>
        <div class="text-xs text-slate-400 border-t border-slate-800/80 pt-3 flex items-center justify-between">
          <span>{t.painPoints.card1.metricLabel}</span>
          <span class="text-emerald-400 font-mono font-medium">{t.painPoints.card1.metricVal}</span>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="card-glow p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400">
              <i class="ri-time-line text-xl"></i>
            </div>
            <div>
              <span class="text-xs font-mono text-amber-400 block uppercase">{t.painPoints.card2.tag}</span>
              <h3 class="text-lg font-bold text-white">{t.painPoints.card2.title}</h3>
            </div>
          </div>
          
          <div class="space-y-3 mb-6">
            <div class="p-3 rounded-lg bg-red-950/20 border border-red-900/30 text-xs text-red-300">
              <div class="font-semibold flex items-center gap-1 mb-1">
                <i class="ri-close-circle-fill text-red-400"></i>
                <span>{t.painPoints.card2.tradTitle}</span>
              </div>
              {t.painPoints.card2.tradDesc}
            </div>

            <div class="p-3 rounded-lg bg-emerald-950/20 border border-emerald-900/30 text-xs text-emerald-300">
              <div class="font-semibold flex items-center gap-1 mb-1">
                <i class="ri-checkbox-circle-fill text-emerald-400"></i>
                <span>{t.painPoints.card2.solTitle}</span>
              </div>
              {t.painPoints.card2.solDesc}
            </div>
          </div>
        </div>
        <div class="text-xs text-slate-400 border-t border-slate-800/80 pt-3 flex items-center justify-between">
          <span>{t.painPoints.card2.metricLabel}</span>
          <span class="text-emerald-400 font-mono font-medium">{t.painPoints.card2.metricVal}</span>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="card-glow p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400">
              <i class="ri-git-pull-request-line text-xl"></i>
            </div>
            <div>
              <span class="text-xs font-mono text-purple-400 block uppercase">{t.painPoints.card3.tag}</span>
              <h3 class="text-lg font-bold text-white">{t.painPoints.card3.title}</h3>
            </div>
          </div>
          
          <div class="space-y-3 mb-6">
            <div class="p-3 rounded-lg bg-red-950/20 border border-red-900/30 text-xs text-red-300">
              <div class="font-semibold flex items-center gap-1 mb-1">
                <i class="ri-close-circle-fill text-red-400"></i>
                <span>{t.painPoints.card3.tradTitle}</span>
              </div>
              {t.painPoints.card3.tradDesc}
            </div>

            <div class="p-3 rounded-lg bg-emerald-950/20 border border-emerald-900/30 text-xs text-emerald-300">
              <div class="font-semibold flex items-center gap-1 mb-1">
                <i class="ri-checkbox-circle-fill text-emerald-400"></i>
                <span>{t.painPoints.card3.solTitle}</span>
              </div>
              {t.painPoints.card3.solDesc}
            </div>
          </div>
        </div>
        <div class="text-xs text-slate-400 border-t border-slate-800/80 pt-3 flex items-center justify-between">
          <span>{t.painPoints.card3.metricLabel}</span>
          <span class="text-emerald-400 font-mono font-medium">{t.painPoints.card3.metricVal}</span>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="card-glow p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400">
              <i class="ri-database-2-line text-xl"></i>
            </div>
            <div>
              <span class="text-xs font-mono text-blue-400 block uppercase">{t.painPoints.card4.tag}</span>
              <h3 class="text-lg font-bold text-white">{t.painPoints.card4.title}</h3>
            </div>
          </div>
          
          <div class="space-y-3 mb-6">
            <div class="p-3 rounded-lg bg-red-950/20 border border-red-900/30 text-xs text-red-300">
              <div class="font-semibold flex items-center gap-1 mb-1">
                <i class="ri-close-circle-fill text-red-400"></i>
                <span>{t.painPoints.card4.tradTitle}</span>
              </div>
              {t.painPoints.card4.tradDesc}
            </div>

            <div class="p-3 rounded-lg bg-emerald-950/20 border border-emerald-900/30 text-xs text-emerald-300">
              <div class="font-semibold flex items-center gap-1 mb-1">
                <i class="ri-checkbox-circle-fill text-emerald-400"></i>
                <span>{t.painPoints.card4.solTitle}</span>
              </div>
              {t.painPoints.card4.solDesc}
            </div>
          </div>
        </div>
        <div class="text-xs text-slate-400 border-t border-slate-800/80 pt-3 flex items-center justify-between">
          <span>{t.painPoints.card4.metricLabel}</span>
          <span class="text-emerald-400 font-mono font-medium">{t.painPoints.card4.metricVal}</span>
        </div>
      </div>

    </div>
  </div>
</section>
