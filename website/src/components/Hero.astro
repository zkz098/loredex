---
// Hero.astro
import { type Lang, useTranslations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden bg-grid-pattern">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      
      <!-- Release / Version Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium mb-6 backdrop-blur-md hover:border-emerald-400/40 transition-colors">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-semibold">{t.hero.badge}</span>
        <i class="ri-arrow-right-s-line text-sm"></i>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-[1.15] mb-6">
        {t.hero.titlePrefix}<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">
          {t.hero.titleHighlight}
        </span> {t.hero.titleSuffix}
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-slate-300 max-w-3xl leading-relaxed mb-8">
        {t.hero.subtitle}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-10 w-full sm:w-auto">
        <a href="#quickstart" class="btn-primary w-full sm:w-auto text-base !px-6 !py-3">
          <i class="ri-flashlight-fill text-lg"></i>
          <span>{t.hero.ctaPrimary}</span>
        </a>

        <a href="#dual-entry" class="btn-secondary w-full sm:w-auto text-base !px-6 !py-3">
          <i class="ri-terminal-box-line text-lg text-emerald-400"></i>
          <span>{t.hero.ctaSecondary}</span>
        </a>

        <a href="https://github.com/zkz098/loredex" target="_blank" rel="noopener noreferrer" class="btn-secondary w-full sm:w-auto text-base !px-5 !py-3">
          <i class="ri-github-fill text-lg"></i>
          <span>GitHub</span>
        </a>
      </div>

      <!-- Copyable CLI Install Command Bar -->
      <div class="w-full max-w-xl mx-auto bg-slate-900/90 border border-slate-800 rounded-xl p-2.5 flex items-center justify-between gap-3 shadow-2xl backdrop-blur-md mb-14">
        <div class="flex items-center gap-2 overflow-x-auto text-xs sm:text-sm font-mono text-slate-300 px-2 py-1">
          <span class="text-emerald-400 select-none">$</span>
          <span id="hero-install-cmd" class="whitespace-nowrap">{t.hero.installCmd}</span>
        </div>
        <button
          type="button"
          data-copy-target="#hero-install-cmd"
          class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium flex items-center gap-1.5 transition-colors border border-slate-700/60"
          title={t.hero.copy}
        >
          <i class="ri-file-copy-line text-emerald-400"></i>
          <span>{t.hero.copy}</span>
        </button>
      </div>

      <!-- Hero Visual: Interactive Evidence & Verification Terminal Mockup -->
      <div class="w-full max-w-5xl rounded-2xl overflow-hidden border border-slate-800/90 bg-[#0c101d] shadow-2xl shadow-emerald-500/5 text-left">
        <!-- Terminal Header -->
        <div class="bg-slate-900/80 px-4 py-3 border-b border-slate-800/80 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
            <span class="text-xs font-mono text-slate-400 ml-2">{t.hero.terminal.fileName}</span>
          </div>
          <div class="flex items-center gap-3 text-xs font-mono">
            <span class="badge-pill bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              <i class="ri-checkbox-circle-fill"></i>
              <span>{t.hero.terminal.status}</span>
            </span>
            <span class="text-slate-500 hidden sm:inline">{t.hero.terminal.headSha}</span>
          </div>
        </div>

        <!-- Terminal Body (Dual Columns) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-slate-800/80">
          <!-- Left Column: Markdown Page Content with Live Citation -->
          <div class="lg:col-span-7 p-5 sm:p-6 font-mono text-xs sm:text-sm text-slate-300 leading-relaxed bg-[#0a0d18]/70">
            <div class="text-slate-500 mb-2">// Markdown page with verifiable inline citations</div>
            <div class="space-y-3">
              <p>
                <span class="text-purple-400 font-semibold">#</span> <span class="text-white font-bold">{t.hero.terminal.title}</span>
              </p>
              <p class="text-slate-300">
                {t.hero.terminal.desc1}
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-emerald-950/70 text-emerald-300 border border-emerald-600/40 text-xs hover:bg-emerald-900/80 transition-colors cursor-pointer" title="Git Snapshot">
                  <i class="ri-git-commit-line text-emerald-400"></i>
                  [[cite:crates/core/src/model.rs:L14-L28]]
                </span>
                {t.hero.terminal.desc2}
              </p>
              <p class="text-slate-300">
                {t.hero.terminal.desc3}
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-teal-950/70 text-teal-300 border border-teal-600/40 text-xs hover:bg-teal-900/80 transition-colors cursor-pointer" title="Git Snapshot">
                  <i class="ri-git-commit-line text-teal-400"></i>
                  [[cite:crates/engine/src/check.rs:L52-L68]]
                </span>
                {t.hero.terminal.desc4}
              </p>
              <div class="p-3 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-400 text-xs mt-4">
                <div class="flex items-center justify-between text-slate-500 pb-2 border-b border-slate-800/60 mb-2">
                  <span>{t.hero.terminal.frontmatterTitle}</span>
                  <span class="text-[10px] text-emerald-400 font-mono">YAML</span>
                </div>
                <div class="text-emerald-300">evidence:</div>
                <div class="pl-3 text-slate-400">- path: <span class="text-amber-200">"crates/core/src/model.rs"</span></div>
                <div class="pl-5 text-slate-400">lines: <span class="text-blue-300">[14, 28]</span></div>
                <div class="pl-5 text-slate-400">blob_sha: <span class="text-indigo-300">"7a9c8b3..."</span></div>
                <div class="pl-5 text-slate-400">content_sha1: <span class="text-emerald-400">"f4d2e1..."</span></div>
              </div>
            </div>
          </div>

          <!-- Right Column: Git Engine Realtime Verifier -->
          <div class="lg:col-span-5 p-5 sm:p-6 bg-[#080b14] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
                  <i class="ri-cpu-line text-emerald-400"></i>
                  <span>{t.hero.terminal.pipelineTitle}</span>
                </span>
                <span class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">
                  0.42ms
                </span>
              </div>

              <!-- Pipeline Steps -->
              <div class="space-y-3 font-mono text-xs">
                <div class="p-2.5 rounded-lg bg-slate-900/90 border border-slate-800 flex items-start gap-2.5">
                  <i class="ri-check-line text-emerald-400 mt-0.5"></i>
                  <div>
                    <div class="text-slate-200 font-medium">{t.hero.terminal.step1Title}</div>
                    <div class="text-slate-400 text-[11px]">{t.hero.terminal.step1Desc}</div>
                  </div>
                </div>

                <div class="p-2.5 rounded-lg bg-slate-900/90 border border-slate-800 flex items-start gap-2.5">
                  <i class="ri-check-line text-emerald-400 mt-0.5"></i>
                  <div>
                    <div class="text-slate-200 font-medium">{t.hero.terminal.step2Title}</div>
                    <div class="text-slate-400 text-[11px]">{t.hero.terminal.step2Desc}</div>
                  </div>
                </div>

                <div class="p-2.5 rounded-lg bg-slate-900/90 border border-slate-800 flex items-start gap-2.5">
                  <i class="ri-shield-keyhole-line text-teal-400 mt-0.5"></i>
                  <div>
                    <div class="text-slate-200 font-medium">{t.hero.terminal.step3Title}</div>
                    <div class="text-slate-400 text-[11px]">{t.hero.terminal.step3Desc}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Terminal Bottom Action -->
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
              <span class="flex items-center gap-1 text-slate-400">
                <i class="ri-flashlight-line text-emerald-400"></i>
                <span>{t.hero.terminal.autoMaintenance}</span>
              </span>
              <span class="text-emerald-400 font-semibold font-mono">{t.hero.terminal.healthStatus}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Highlights / Stats Bar -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 w-full max-w-5xl mt-12 pt-8 border-t border-slate-800/80 text-center">
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 backdrop-blur-sm">
          <div class="text-2xl sm:text-3xl font-bold text-white font-mono flex items-center justify-center gap-1">
            <span>{t.hero.stats.stat1Value}</span>
            <span class="text-xs font-normal text-emerald-400 uppercase">DB</span>
          </div>
          <div class="text-xs text-slate-400 mt-1">{t.hero.stats.stat1Label}</div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 backdrop-blur-sm">
          <div class="text-2xl sm:text-3xl font-bold text-emerald-400 font-mono">
            {t.hero.stats.stat2Value}
          </div>
          <div class="text-xs text-slate-400 mt-1">{t.hero.stats.stat2Label}</div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 backdrop-blur-sm">
          <div class="text-2xl sm:text-3xl font-bold text-white font-mono">
            {t.hero.stats.stat3Value}
          </div>
          <div class="text-xs text-slate-400 mt-1">{t.hero.stats.stat3Label}</div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 backdrop-blur-sm">
          <div class="text-2xl sm:text-3xl font-bold text-teal-400 font-mono">
            {t.hero.stats.stat4Value}
          </div>
          <div class="text-xs text-slate-400 mt-1">{t.hero.stats.stat4Label}</div>
        </div>
      </div>

    </div>
  </div>
</section>
