---
// QuickStart.astro
import { type Lang, useTranslations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);

const mcpConfigCode = `{
  "mcpServers": {
    "loredex": {
      "command": "loredex-mcp"
    }
  }
}`;
---

<section id="quickstart" class="py-24 bg-[#090d18]/70 border-t border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-emerald-500/20">
        <i class="ri-rocket-line"></i>
        <span>{t.quickstart.badge}</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t.quickstart.title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        {t.quickstart.description}
      </p>
    </div>

    <!-- Quickstart Container -->
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Step 1: Installation -->
      <div class="card-glow p-6 sm:p-7">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold font-mono text-sm">
            1
          </span>
          <h3 class="text-lg font-bold text-white">{t.quickstart.step1}</h3>
        </div>

        <div class="space-y-4">
          <!-- Install Method A: Cargo -->
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
              <span>{t.quickstart.methodA}</span>
              <button
                type="button"
                data-copy-text="cargo install loredex-cli loredex-mcp"
                class="hover:text-white transition-colors flex items-center gap-1"
              >
                <i class="ri-file-copy-line text-emerald-400"></i>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-emerald-300 overflow-x-auto">
              cargo install loredex-cli loredex-mcp
            </div>
          </div>

          <!-- Install Method B: Binstall or Prebuilt -->
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
              <span>{t.quickstart.methodB}</span>
              <button
                type="button"
                data-copy-text="cargo binstall loredex-cli loredex-mcp"
                class="hover:text-white transition-colors flex items-center gap-1"
              >
                <i class="ri-file-copy-line text-emerald-400"></i>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-teal-300 overflow-x-auto">
              cargo binstall loredex-cli loredex-mcp
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: Initialize Repo -->
      <div class="card-glow p-6 sm:p-7">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-lg bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 font-bold font-mono text-sm">
            2
          </span>
          <h3 class="text-lg font-bold text-white">{t.quickstart.step2}</h3>
        </div>

        <div class="space-y-3">
          <p class="text-xs text-slate-300">
            {t.quickstart.step2Desc}
          </p>
          <div class="relative">
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-200 overflow-x-auto space-y-1">
              <div><span class="text-slate-500"># Enter your git repo root</span></div>
              <div><span class="text-emerald-400">$</span> cd /path/to/your-repo</div>
              <div><span class="text-emerald-400">$</span> loredex init</div>
              <div><span class="text-slate-500"># Output: Created .wiki/pages/, wiki.toml, ignored .wiki/.cache/</span></div>
            </div>
            <button
              type="button"
              data-copy-text="cd /path/to/your-repo && loredex init"
              class="absolute top-3 right-3 px-2.5 py-1 rounded bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-xs flex items-center gap-1 transition-colors border border-slate-700"
            >
              <i class="ri-file-copy-line text-emerald-400"></i>
              <span>Copy</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Step 3: Auto-heal & Maintenance -->
      <div class="card-glow p-6 sm:p-7">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold font-mono text-sm">
            3
          </span>
          <h3 class="text-lg font-bold text-white">{t.quickstart.step3}</h3>
        </div>

        <div class="space-y-3">
          <p class="text-xs text-slate-300">
            {t.quickstart.step3Desc}
          </p>
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-200 overflow-x-auto space-y-1.5">
            <div><span class="text-emerald-400">$</span> loredex auto</div>
            <div><span class="text-emerald-400">$</span> loredex check --mark</div>
            <div><span class="text-emerald-400">$</span> loredex index</div>
          </div>
        </div>
      </div>

      <!-- Step 4: Add to AI Agent (MCP) -->
      <div class="card-glow p-6 sm:p-7">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold font-mono text-sm">
            4
          </span>
          <h3 class="text-lg font-bold text-white">{t.quickstart.step4}</h3>
        </div>

        <p class="text-xs text-slate-300 mb-3">
          {t.quickstart.step4Desc}
        </p>

        <div class="relative">
          <pre class="p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 overflow-x-auto" id="mcp-quick-json">{mcpConfigCode}</pre>
          <button
            type="button"
            data-copy-target="#mcp-quick-json"
            class="absolute top-3 right-3 px-2.5 py-1 rounded bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-xs flex items-center gap-1 transition-colors border border-slate-700"
          >
            <i class="ri-file-copy-line text-emerald-400"></i>
            <span>Copy</span>
          </button>
        </div>
      </div>

    </div>
  </div>
</section>
