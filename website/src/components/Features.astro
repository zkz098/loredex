---
// Features.astro
import { type Lang, useTranslations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);

const icons = [
  'ri-pushpin-line',
  'ri-git-commit-line',
  'ri-route-line',
  'ri-cursor-line',
  'ri-shield-keyhole-line',
  'ri-markdown-line',
];

const colors = [
  { text: 'text-emerald-400', bg: 'bg-emerald-500/10', border: 'border-emerald-500/20', hoverBorder: 'group-hover:border-emerald-400/50', hoverText: 'group-hover:text-emerald-400' },
  { text: 'text-teal-400', bg: 'bg-teal-500/10', border: 'border-teal-500/20', hoverBorder: 'group-hover:border-teal-400/50', hoverText: 'group-hover:text-teal-400' },
  { text: 'text-cyan-400', bg: 'bg-cyan-500/10', border: 'border-cyan-500/20', hoverBorder: 'group-hover:border-cyan-400/50', hoverText: 'group-hover:text-cyan-400' },
  { text: 'text-indigo-400', bg: 'bg-indigo-500/10', border: 'border-indigo-500/20', hoverBorder: 'group-hover:border-indigo-400/50', hoverText: 'group-hover:text-indigo-400' },
  { text: 'text-rose-400', bg: 'bg-rose-500/10', border: 'border-rose-500/20', hoverBorder: 'group-hover:border-rose-400/50', hoverText: 'group-hover:text-rose-400' },
  { text: 'text-amber-400', bg: 'bg-amber-500/10', border: 'border-amber-500/20', hoverBorder: 'group-hover:border-amber-400/50', hoverText: 'group-hover:text-amber-400' },
];
---

<section id="features" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-emerald-500/20">
        <i class="ri-flashlight-line"></i>
        <span>{t.features.badge}</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t.features.title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        {t.features.description}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {t.features.items.map((item, idx) => {
        const icon = icons[idx % icons.length];
        const color = colors[idx % colors.length];
        return (
          <div class="card-glow p-6 sm:p-7 flex flex-col justify-between group">
            <div>
              <div class={`w-12 h-12 rounded-xl ${color.bg} border ${color.border} flex items-center justify-center ${color.text} mb-5 group-hover:scale-110 ${color.hoverBorder} transition-all duration-300`}>
                <i class={`${icon} text-2xl`}></i>
              </div>
              <h3 class={`text-xl font-bold text-white mb-2 ${color.hoverText} transition-colors`}>
                {item.title}
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-4">
                {item.desc}
              </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400 font-mono">
              <span>{item.tag}</span>
              <span class={color.text}>{item.value}</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
