---
// DualEntry.astro
import { type Lang, useTranslations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);

const diffJson = `{
  "base": "main",
  "head": "feat/async-worker",
  "affected_pages": ["pages/architecture.md"],
  "broken_citations": 0,
  "projectable_citations": 1
}`;

const mcpConfigExamples = `// 1. Zero-config global setup (4-layer resolution)
{
  "mcpServers": {
    "loredex": {
      "command": "loredex-mcp"
    }
  }
}

// 2. Or pin to a single repository path
{
  "mcpServers": {
    "loredex": {
      "command": "loredex-mcp",
      "args": ["--repo", "/path/to/your-repo"]
    }
  }
}`;
---

<section id="dual-entry" class="py-24 bg-[#090d18]/70 border-t border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-cyan-500/20">
        <i class="ri-terminal-box-line"></i>
        <span>{t.dualEntry.badge}</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t.dualEntry.title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        {t.dualEntry.description}
      </p>
    </div>

    <!-- Interactive Tabs Switcher -->
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-center gap-2 p-1.5 bg-slate-900/90 border border-slate-800 rounded-xl mb-8 max-w-md mx-auto backdrop-blur-md">
        <button
          type="button"
          id="tab-btn-cli"
          class="tab-btn flex-1 py-2 px-4 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 bg-emerald-500 text-white shadow-md shadow-emerald-500/20"
        >
          <i class="ri-terminal-line"></i>
          <span>{t.dualEntry.cliTab}</span>
        </button>
        <button
          type="button"
          id="tab-btn-mcp"
          class="tab-btn flex-1 py-2 px-4 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 text-slate-400 hover:text-white"
        >
          <i class="ri-robot-2-line"></i>
          <span>{t.dualEntry.mcpTab}</span>
        </button>
      </div>

      <!-- Tab Content 1: CLI -->
      <div id="tab-pane-cli" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- Commands List -->
          <div class="lg:col-span-5 space-y-3">
            <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-2 flex items-center gap-2">
              <i class="ri-command-line text-emerald-400"></i>
              <span>{t.dualEntry.cliHeading}</span>
            </h3>

            {t.dualEntry.cmds.map((cmd) => (
              <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800/80 hover:border-emerald-500/30 transition-all cursor-pointer group">
                <div class="flex items-center justify-between text-xs font-mono mb-1">
                  <span class="text-emerald-400 font-bold group-hover:underline">{cmd.name}</span>
                  <span class="text-slate-500">{cmd.badge}</span>
                </div>
                <p class="text-xs text-slate-400">{cmd.desc}</p>
              </div>
            ))}
          </div>

          <!-- Terminal Emulator Preview -->
          <div class="lg:col-span-7 rounded-2xl overflow-hidden border border-slate-800 bg-[#070a12] shadow-2xl flex flex-col">
            <div class="bg-slate-900 px-4 py-2.5 border-b border-slate-800 flex items-center justify-between text-xs text-slate-400 font-mono">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
                <span class="text-slate-400 ml-1">Terminal: bash</span>
              </div>
              <button
                type="button"
                data-copy-target="#cli-terminal-code"
                class="hover:text-white transition-colors flex items-center gap-1"
                title={t.dualEntry.executeCopy}
              >
                <i class="ri-file-copy-line"></i>
                <span>{t.dualEntry.executeCopy}</span>
              </button>
            </div>
            <div class="p-5 font-mono text-xs text-slate-300 leading-relaxed overflow-x-auto flex-1 bg-[#05070e]" id="cli-terminal-code">
              <div class="text-slate-500 mb-2"># 1. Run algorithmic maintenance and checks</div>
              <div class="text-emerald-400">$ loredex auto</div>
              <div class="text-slate-400 pl-4 py-1">
                ✓ Scanning repository HEAD at commit 9b82f0c<br />
                ✓ Verified: 14 pages intact (0 stale)<br />
                ✓ Drift projection: 2 pages auto-healed (similarity &gt; 0.92)<br />
                ✓ Security audit: 0 sensitive secrets detected<br />
                ✓ Lint passed cleanly. Wiki state: 100% verified.
              </div>
              <div class="text-slate-500 my-2"># 2. Inspect pull request change impact on citations</div>
              <div class="text-emerald-400">$ loredex diff --since main --json</div>
              <pre class="text-slate-400 pl-4 py-1 font-mono text-xs overflow-x-auto">{diffJson}</pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab Content 2: MCP Server -->
      <div id="tab-pane-mcp" class="hidden space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- MCP Tools Grid -->
          <div class="lg:col-span-6 space-y-3">
            <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-2 flex items-center gap-2">
              <i class="ri-tools-line text-cyan-400"></i>
              <span>{t.dualEntry.mcpHeading}</span>
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs font-mono">
              {t.dualEntry.tools.map((tool) => (
                <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
                  <span class="text-cyan-400 font-bold block mb-1">{tool.name}</span>
                  <span class="text-slate-400 font-sans text-[11px]">{tool.desc}</span>
                </div>
              ))}
            </div>

            <!-- Resolution Chain Banner -->
            <div class="p-3.5 rounded-xl bg-cyan-950/20 border border-cyan-800/40 text-xs text-cyan-300">
              <span class="font-bold flex items-center gap-1 mb-1">
                <i class="ri-links-line"></i>
                <span>{t.dualEntry.chainTitle}</span>
              </span>
              <span class="text-slate-400">
                {t.dualEntry.chainDesc}
              </span>
            </div>
          </div>

          <!-- MCP Config JSON Code Block -->
          <div class="lg:col-span-6 rounded-2xl overflow-hidden border border-slate-800 bg-[#070a12] shadow-2xl flex flex-col">
            <div class="bg-slate-900 px-4 py-2.5 border-b border-slate-800 flex items-center justify-between text-xs text-slate-400 font-mono">
              <div class="flex items-center gap-2">
                <i class="ri-settings-4-line text-cyan-400"></i>
                <span>claude_desktop_config.json / mcp.json</span>
              </div>
              <button
                type="button"
                data-copy-target="#mcp-config-code"
                class="hover:text-white transition-colors flex items-center gap-1"
                title={t.dualEntry.copyConfig}
              >
                <i class="ri-file-copy-line"></i>
                <span>{t.dualEntry.copyConfig}</span>
              </button>
            </div>
            <pre class="p-5 font-mono text-xs text-slate-300 leading-relaxed overflow-x-auto flex-1 bg-[#05070e]" id="mcp-config-code">{mcpConfigExamples}</pre>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const cliBtn = document.getElementById('tab-btn-cli');
  const mcpBtn = document.getElementById('tab-btn-mcp');
  const cliPane = document.getElementById('tab-pane-cli');
  const mcpPane = document.getElementById('tab-pane-mcp');

  if (cliBtn && mcpBtn && cliPane && mcpPane) {
    cliBtn.addEventListener('click', () => {
      cliPane.classList.remove('hidden');
      mcpPane.classList.add('hidden');
      cliBtn.className = 'tab-btn flex-1 py-2 px-4 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 bg-emerald-500 text-white shadow-md shadow-emerald-500/20';
      mcpBtn.className = 'tab-btn flex-1 py-2 px-4 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 text-slate-400 hover:text-white';
    });

    mcpBtn.addEventListener('click', () => {
      mcpPane.classList.remove('hidden');
      cliPane.classList.add('hidden');
      mcpBtn.className = 'tab-btn flex-1 py-2 px-4 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 bg-cyan-500 text-white shadow-md shadow-cyan-500/20';
      cliBtn.className = 'tab-btn flex-1 py-2 px-4 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 text-slate-400 hover:text-white';
    });
  }
</script>
