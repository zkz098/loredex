---
// Footer.astro
import { type Lang, useTranslations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);
const homeUrl = lang === 'zh' ? '/' : '/en';
---

<footer class="border-t border-slate-800/80 bg-[#06080e] pt-16 pb-12 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800/80">
      
      <!-- Brand & Mission (Col 1 & 2) -->
      <div class="lg:col-span-2 space-y-4">
        <a href={homeUrl} class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500/20 to-teal-500/10 border border-emerald-500/30 flex items-center justify-center p-1.5 shadow-sm">
            <img src="/favicon.svg" alt="Loredex Logo" class="w-full h-full object-contain" />
          </div>
          <span class="font-bold text-xl text-white tracking-tight">Loredex</span>
        </a>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          {t.footer.mission}
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://github.com/zkz098/loredex"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 hover:text-white hover:border-slate-700 transition-colors"
            title="GitHub"
          >
            <i class="ri-github-fill text-lg"></i>
          </a>
          <a
            href="https://crates.io/crates/loredex-cli"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 h-9 rounded-lg bg-slate-900 border border-slate-800 flex items-center gap-1.5 text-xs font-mono text-slate-300 hover:text-white hover:border-slate-700 transition-colors"
            title="crates.io"
          >
            <i class="ri-box-3-line text-emerald-400"></i>
            <span>crates.io</span>
          </a>
          <span class="text-xs font-mono px-2 py-1 rounded bg-slate-900 border border-slate-800 text-slate-400">
            v0.1.6
          </span>
        </div>
      </div>

      <!-- Navigation Links (Col 3) -->
      <div>
        <h4 class="text-xs font-semibold text-white uppercase tracking-wider mb-4 font-mono">
          {t.footer.productAndArch}
        </h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li><a href="#features" class="hover:text-emerald-400 transition-colors">{t.nav.features}</a></li>
          <li><a href="#dual-entry" class="hover:text-emerald-400 transition-colors">{t.nav.dualEntry}</a></li>
          <li><a href="#workflow" class="hover:text-emerald-400 transition-colors">{t.nav.workflow}</a></li>
          <li><a href="#architecture" class="hover:text-emerald-400 transition-colors">{t.nav.architecture}</a></li>
          <li><a href="#quickstart" class="hover:text-emerald-400 transition-colors">{t.nav.quickstart}</a></li>
        </ul>
      </div>

      <!-- Protocol & Crates (Col 4) -->
      <div>
        <h4 class="text-xs font-semibold text-white uppercase tracking-wider mb-4 font-mono">
          {t.footer.techAndTools}
        </h4>
        <ul class="space-y-2.5 text-sm text-slate-400 font-mono text-xs">
          <li><a href="https://github.com/zkz098/loredex/tree/main/crates/loredex-cli" target="_blank" class="hover:text-emerald-400 transition-colors">loredex-cli</a></li>
          <li><a href="https://github.com/zkz098/loredex/tree/main/crates/loredex-mcp" target="_blank" class="hover:text-cyan-400 transition-colors">loredex-mcp (MCP)</a></li>
          <li><a href="https://github.com/zkz098/loredex/tree/main/crates/loredex-engine" target="_blank" class="hover:text-teal-400 transition-colors">loredex-engine</a></li>
          <li><a href="https://github.com/zkz098/loredex/tree/main/crates/loredex-git" target="_blank" class="hover:text-indigo-400 transition-colors">loredex-git</a></li>
          <li><a href="https://github.com/zkz098/loredex/tree/main/crates/loredex-core" target="_blank" class="hover:text-purple-400 transition-colors">loredex-core</a></li>
        </ul>
      </div>

      <!-- Community & License (Col 5) -->
      <div>
        <h4 class="text-xs font-semibold text-white uppercase tracking-wider mb-4 font-mono">
          {t.footer.openSourceLicense}
        </h4>
        <p class="text-xs text-slate-400 leading-relaxed mb-3">
          {t.footer.licenseText} <a href="https://github.com/zkz098/loredex/blob/main/LICENSE" target="_blank" class="text-emerald-400 hover:underline">GPL-3.0-or-later</a>
        </p>
        <p class="text-[11px] text-slate-500 leading-relaxed">
          <i class="ri-shield-check-line text-emerald-400 mr-1"></i>
          {t.footer.licenseNote}
        </p>
      </div>

    </div>

    <!-- Bottom Copyright & Badges -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        {t.footer.copyright}
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <span class="flex items-center gap-1.5">
          <i class="ri-code-box-line text-emerald-400"></i>
          <span>Astro</span>
        </span>
        <span>&bull;</span>
        <span class="flex items-center gap-1.5">
          <i class="ri-flashlight-line text-teal-400"></i>
          <span>UnoCSS</span>
        </span>
        <span>&bull;</span>
        <span class="flex items-center gap-1.5">
          <i class="ri-remixicon-line text-cyan-400"></i>
          <span>Remix Icon</span>
        </span>
      </div>
    </div>
  </div>
</footer>
