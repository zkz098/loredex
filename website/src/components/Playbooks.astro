---
// Playbooks.astro
import { type Lang, useTranslations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);

const playbookIcons = [
  { icon: 'ri-building-2-line', color: 'text-emerald-400' },
  { icon: 'ri-flow-chart', color: 'text-teal-400' },
  { icon: 'ri-settings-line', color: 'text-cyan-400' },
  { icon: 'ri-links-line', color: 'text-blue-400' },
  { icon: 'ri-test-tube-line', color: 'text-purple-400' },
  { icon: 'ri-shield-cross-line', color: 'text-rose-400' },
  { icon: 'ri-stethoscope-line', color: 'text-amber-400' },
  { icon: 'ri-scales-3-line', color: 'text-indigo-400' },
];
---

<section class="py-20 bg-[#090d18]/50 border-t border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-indigo-500/20">
        <i class="ri-booklet-line"></i>
        <span>{t.playbooks.badge}</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t.playbooks.title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        {t.playbooks.description}
      </p>
    </div>

    <!-- Playbooks Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {t.playbooks.types.map((item, idx) => {
        const style = playbookIcons[idx % playbookIcons.length];
        return (
          <div class="card-glow p-5 flex flex-col justify-between">
            <div>
              <div class={`flex items-center gap-2.5 mb-3 ${style.color}`}>
                <i class={`${style.icon} text-xl`}></i>
                <h3 class="font-bold text-white text-base">{item.name}</h3>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                {item.desc}
              </p>
            </div>
            <div class="text-[11px] font-mono text-slate-400 border-t border-slate-800/80 pt-2.5">
              {item.sections}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Playbook extension note -->
    <div class="mt-8 text-center text-xs text-slate-400">
      <i class="ri-information-line text-emerald-400 mr-1"></i>
      {t.playbooks.customTip}
    </div>

  </div>
</section>
