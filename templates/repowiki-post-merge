#!/bin/sh
# repowiki post-merge/post-checkout reminder hook.
# Install: cp templates/repowiki-post-merge .git/hooks/post-merge && chmod +x .git/hooks/post-merge
# (or use core.hooksPath). Silent when repowiki or .wiki is absent.
if command -v repowiki >/dev/null 2>&1 && [ -d .wiki ]; then
  if ! repowiki auto >/dev/null 2>&1; then
    echo "repowiki: wiki needs author attention after this merge -> run: repowiki plan"
  fi
fi
